{
  "name": "quill-track",
  "productName": "Quill Track",
  "version": "0.2.0",
  "description": "Задачи и учёт времени – спокойный аналог SuperProductivity для Windows",
  "author": "Evgenii Svalov",
  "license": "MIT",
  "homepage": "https://github.com/worldruschel/quill-track",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldruschel/quill-track.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "app.quilltrack",
    "productName": "Quill Track",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Quill Track",
      "runAfterFinish": true,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "QuillTrack-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "QuillTrack-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "worldruschel",
        "repo": "quill-track",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
